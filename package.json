{
  "name": "dotx-streamdeck-companion",
  "version": "0.1.1",
  "description": "Dot X marketplace plugin for the Elgato Stream Deck integration",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=dist/main.js --format=cjs --platform=node --target=node16 --minify",
    "dev": "esbuild main.ts --bundle --outfile=dist/main.js --format=cjs --platform=node --target=node16 --watch",
    "package": "npm run build && dotx-plugin package"
  },
  "dependencies": {
    "@dotmatrixlabs/dotx-plugin-sdk": "1.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.6",
    "typescript": "^5.7.0"
  },
  "author": "DotMatrixLabs",
  "license": "MIT"
}
